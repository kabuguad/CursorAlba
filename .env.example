# API Configuration
# Copy this file to .env.local and set your own backend URL.
# Vite will automatically pick up .env.local on startup.
#
# Use cases:
#   - Running the .NET API locally:  VITE_API_BASE=http://localhost:5100
#   - New ngrok tunnel:              VITE_API_BASE=https://your-new-tunnel.ngrok-free.dev
#   - Deployed API:                  VITE_API_BASE=https://api.alberschool.ke
#
# If this variable is not set, the default ngrok URL in vite.config.ts is used.
VITE_API_BASE=https://your-api-url.ngrok-free.dev
